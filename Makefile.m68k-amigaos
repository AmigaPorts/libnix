# libnix Makefile for m68k-amigaos-gcc.  Makefile is a symlink to it.
# It builds in the current directory: the source directory, or a build
# directory, with make -f <sources>/Makefile.m68k-amigaos.

MAJOR=0
MINOR=1

PREFIX ?= /opt/amiga

CFLAGS ?= -Os -fomit-frame-pointer

uname := $(shell uname)
# the sources: where this file is, unless the caller says
ifeq ($(origin root),undefined)
root := $(patsubst %/,%,$(dir $(realpath $(lastword $(MAKEFILE_LIST)))))
endif
export root

target ?= m68k-amigaos

# sfdc writes the library bases of libstubs.a, and the library stubs and LVO
# symbols of libamiga.a, from the NDK's SFD files, into $(gen) in the top-level
# build directory: one copy serves every multilib.
SFDC ?= sfdc
SFD_DIR ?= $(PREFIX)/$(target)/ndk/lib/sfd
gen ?= $(CURDIR)/gen
export gen

# The sub-makes run in the build directories without -f: make reads this file there through MAKEFILES.
MAKEFILES=$(root)/Makefile.m68k-amigaos

# special path handling for msys2 started from Eclipse
ifneq (,$(findstring MSYS_NT,$(uname)))
ifneq (,$(findstring /cygdrive/,$(root)))
troot := $(root)
tdrive := $(word 2,$(subst /, ,$(troot)))
root = $(subst /cygdrive/$(tdrive)/,$(tdrive):/,$(troot))
endif
endif

ifneq (,$(lib))
ifeq (,$(libname))
libname=$(lib)
endif
-include $(root)/sources/$(lib)/steal.me
endif

# use nix13 or nix20
ifeq (,$(lc))
CC = $(target)-gcc
AR = $(target)-ar --target=amiga
AS = $(target)-as

# The multilibs are the compiler's: -print-multi-lib lists one library
# directory per line with the options that select it after a ';', each
# prefixed with '@' (libb/libm020;@fbaserel@m68020-60).  The base directory
# '.' is built in lib/, every other one in a directory of its own name, and
# the FPU directories (m68881) only get libm and libamiga: nothing else depends
# on the FPU.  All but the FPU directories are built at -Os, whatever CFLAGS
# says: $(flags) comes last on the command line.
MULTILIBS := $(shell $(CC) -print-multi-lib)
multilib_dir = $(word 1,$(subst ;, ,$1))
multilib_flags = $(strip $(subst @, -,$(word 2,$(subst ;, ,$1))))
multilib_kind = $(if $(filter .,$(call multilib_dir,$1)),lib,$(call multilib_dir,$1))

VARIANTS_TO_BUILD = info $(foreach m,$(MULTILIBS),$(call multilib_kind,$m))
LIBS_TO_BUILD ?= libnix libnix13 libnix20 libnixmain libnix_main libm libsocket libstub libamiga
STARTUPS ?= lib/devinit.o lib/libinit.o lib/libinitb.o lib/libinitr.o lib/ncrt0.o lib/nbcrt0.o lib/nlbcrt0.o lib/nrcrt0.o lib/nlrcrt0.o lib/init_shared.o

# protect conflicting targets
ifneq (,$(filter all,$(MAKECMDGOALS)))
ifneq (,$(filter libc lib,$(MAKECMDGOALS)))
$(error 'all' cannot be used together with 'libc' or 'lib')
endif
endif

ifneq (,$(filter libc,$(MAKECMDGOALS)))
ifneq (,$(filter lib,$(MAKECMDGOALS)))
$(error 'libc' and 'lib' cannot be used together)
endif
endif

# with clean among the goals, clean first
ifneq (,$(filter clean,$(MAKECMDGOALS)))
$(VARIANTS_TO_BUILD): clean
$(STARTUPS) $(gen)/sfdc/stamp $(gen)/libbases/stamp $(gen)/amiga/stamp: clean
libc: clean
endif

ifneq (,$(lib))
crt = -mcrt=nix13
ifeq (nix20,$(lib))
crt  = -mcrt=nix20
endif
ifeq (socket,$(lib))
crt = -mcrt=nix20
endif
endif
else
CC = m68k-elf-gcc
AR = m68k-elf-ar
AS = m68k-elf-as

TGT = --defsym __elf__=1
VARIANTS_TO_BUILD ?= info libm020
LIBS_TO_BUILD = libc libm
STARTUPS ?= lib/ncrt0.o

endif

# The library's own flags, which follow the caller's CFLAGS on every command
# line.  They are not added to CFLAGS: a sub-make only inherits a CFLAGS that
# came from the environment, not the default or one from the command line.
#
# FAST_MATH=-ffast-math builds with it, which breaks NaN, infinities and signed
# zeros in the math functions, and the exact rounding error fma() and fmaf()
# compute: libc-test fails many of them with it.
FAST_MATH ?=
LIB_CFLAGS = -I$(root)/sources/headers -fno-builtin $(FAST_MATH) -D__libnix__
# The library implements the mem* functions.  Keep loop distribution from
# replacing one of their loops with a call back into the same function.
LIB_CFLAGS += -fno-tree-loop-distribute-patterns
# AmigaOS APIs take STRPTR (unsigned char) strings, so -Wpointer-sign
# would flag every call that passes a plain char string.
LIB_CFLAGS += -Wall -Wno-pointer-sign
# With the gcc we build and test with, more warnings, and all of them errors.
# Older gcc, as in the amiga6 toolchain, lacks some of these options and warns
# differently.  WERROR= keeps them warnings.
ifeq (,$(gcc_major))
gcc_major := $(firstword $(subst ., ,$(shell $(CC) -dumpversion 2>/dev/null)))
export gcc_major
endif
ifeq (y,$(shell test "$(gcc_major)" -ge 16 2>/dev/null && echo y))
WERROR ?= -Werror
# Not -Wunused-parameter: many functions here exist for their name and ignore
# what they are passed.
LIB_CFLAGS += -Wextra -Wno-unused-parameter -Wstrict-prototypes $(WERROR)
endif
LIB_CFLAGS += $(crt)

.PHONY: all one rest clean install install_one info
.PHONY: $(VARIANTS_TO_BUILD)
all: $(VARIANTS_TO_BUILD)

# The tests, in test/: check runs the host ones, check-target the target ones,
# with the installed libraries.  That make must not read this file as well.
.PHONY: check check-target
check check-target:
	$(MAKE) -C $(root)/test MAKEFILES= $@

$(VARIANTS_TO_BUILD): $(STARTUPS) $(gen)/libbases/stamp $(gen)/amiga/stamp

# the base multilib, in lib/
lib:
	@mkdir -p $@
	$(MAKE) one kind=$@ flags="-Os"
	if [ -e lib/libstubs.a ] && $(AR) t lib/libstubs.a | grep -q __initlib; then rm -f lib/libstubs.a; fi

# every other multilib: build in its directory, install into the same
# directory under $(PREFIX)/$(target)/libnix/lib
define multilib_rules
.PHONY: $(1) install_$(subst /,_,$(1))
$(1):
	@mkdir -p $$@
	$$(MAKE) one kind=$$@ flags="$(2)$(if $(findstring m68881,$(2)),, -Os)" $(if $(findstring m68881,$(2)),LIBS_TO_BUILD="libm libamiga")
install_$(subst /,_,$(1)):
	$$(MAKE) install_one kind=$(1) to="$(1)/"
endef
$(foreach m,$(filter-out .;%,$(MULTILIBS)),$(eval $(call multilib_rules,$(call multilib_dir,$m),$(call multilib_flags,$m))))

# the libs to build for each kind
one: $(LIBS_TO_BUILD)

# install all kinds into the prefix
.PHONY: install_lib
install: $(foreach m,$(MULTILIBS),install_$(subst /,_,$(call multilib_kind,$m)))
	cp $(root)/mkstub $(PREFIX)/bin

install_lib:
	$(MAKE) install_one kind=lib to=""
	mv $(PREFIX)/$(target)/libnix/lib/libstubs.a $(PREFIX)/$(target)/lib/

# install the files for the given $(kind) into $(to); libamiga.a goes to the
# library directory that every C library searches
install_one:
	mkdir -p $(PREFIX)/$(target)/libnix/lib/$(to) $(PREFIX)/$(target)/lib/$(to)
	rsync --exclude libamiga.a $(kind)/*.a $(PREFIX)/$(target)/libnix/lib/$(to)
	if [ -e $(kind)/libamiga.a ]; then rsync $(kind)/libamiga.a $(PREFIX)/$(target)/lib/$(to); fi
	find $(kind) -maxdepth 1 -name "*.o" -exec cp {} $(PREFIX)/$(target)/libnix/lib/$(to) \;

# startup stuff
.PHONY: libdir
libdir:
	@mkdir -p lib

lib/devinit.o lib/libinit.o lib/libinitr.o: lib/%.o: $(root)/sources/startup/%.c libdir
	$(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags) $< -o $@

lib/libinitb.o: $(root)/sources/startup/libinit.c libdir
	$(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags) -D__BASEREL__ $< -o $@

# $(TGT) marks the ELF build in the startups that have an ELF variant
lib/ncrt0.o lib/xcrt0.o: lib/%.o: $(root)/sources/startup/%.S libdir
	$(AS) $(TGT) -m68000 $< -o $@

lib/nbcrt0.o lib/nrcrt0.o: lib/%.o: $(root)/sources/startup/%.S libdir
	$(AS) -m68000 $< -o $@

lib/nlbcrt0.o lib/nlrcrt0.o: lib/%.o: $(root)/sources/startup/%.S libdir
	$(AS) -m68020 $< -o $@

lib/init_shared.o: $(root)/sources/startup/init_shared.c libdir
	$(CC) $(CFLAGS) $(LIB_CFLAGS) -fbaserel -m68000 -Os -c $< -o $@

.PHONY: libnix libnix13 libnix20 libnixmain libnix_main libm libsocket libstub libamiga libc
libnix:
	$(MAKE) -C $(kind) rest libnix.a lib=nix
libnix13:
	$(MAKE) -C $(kind) rest libnix13.a lib=nix13
libnix20:
	$(MAKE) -C $(kind) rest libnix20.a lib=nix20
libnixmain:
	$(MAKE) -C $(kind) libnixmain.a lib=nixmain
# Most of libm is fdlibm as newlib has it, kept as it is there: it compares
# signed with unsigned in a few places.
libm:
	$(MAKE) -C $(kind) libm.a lib=math libname=m flags="$(flags) -DFULL_SPECIFIERS -Wno-sign-compare"
libsocket:
	$(MAKE) -C $(kind) libsocket.a lib=socket

# libstubs.a has the library bases that the startup code opens, which sfdc
# writes and sources/stubs/steal.me adds to it.
libstub:
	$(MAKE) -C $(kind) libstubs.a lib=stubs

SFD_FILES = $(wildcard $(SFD_DIR)/*_lib.sfd)

# Both rules that run sfdc wait for this check, and run again after a new
# sfdc.  An sfdc before 1.14 writes bases that do not open and has no lvolib
# mode.
$(gen)/sfdc/stamp: $(shell command -v $(SFDC))
	@v="$$($(SFDC) --version 2>&1 | sed -n 's/^sfdc \([0-9]*\)\.\([0-9]*\).*/\1 \2/p')"; set -- $$v; \
	if [ $$(($${1:-0} * 1000 + $${2:-0})) -lt 1014 ]; then echo "$(SFDC) is sfdc $${1:-?}.$${2:-?}: libnix needs 1.14 or later" >&2; exit 1; fi
	@mkdir -p $(gen)/sfdc && touch $@

# An SFD file with nothing for the startup code to open, such as a device's,
# leaves an empty file.
$(gen)/libbases/stamp: $(SFD_FILES) $(gen)/sfdc/stamp
	@if [ -z "$(SFD_FILES)" ]; then echo "no SFD files in $(SFD_DIR): set SFD_DIR" >&2; exit 1; fi
	rm -rf $(gen)/libbases && mkdir -p $(gen)/libbases
	$(SFDC) --quiet --target=m68k-amigaos --mode=autoopen --output=$(gen)/libbases/%n.c $(SFD_FILES)
	grep -L dlist___LIB_LIST__ $(gen)/libbases/*.c | xargs rm -f
	touch $@

# amiga.lib: sfdc writes a stub for every public function of the NDK's
# libraries, one to a file, and the LVO symbols of each library; sources/amiga
# has the support functions.
libamiga:
	$(MAKE) -C $(kind) libamiga.a

$(gen)/amiga/stamp: $(SFD_FILES) $(gen)/sfdc/stamp
	@if [ -z "$(SFD_FILES)" ]; then echo "no SFD files in $(SFD_DIR): set SFD_DIR" >&2; exit 1; fi
	rm -rf $(gen)/amiga && mkdir -p $(gen)/amiga
	$(SFDC) --quiet --target=m68k-gcc-amigaos --mode=stubs --output=$(gen)/amiga/%f.c $(SFD_FILES)
	$(SFDC) --quiet --target=m68k-gcc-amigaos --mode=lvolib --output=$(gen)/amiga/%n_lvo.s $(SFD_FILES)
	touch $@

libc: $(STARTUPS) $(gen)/libbases/stamp
	$(MAKE) -C lib kind=lib libstubs.a lib=stubs
	$(MAKE) -C $(lc) kind=$(lc) rest libnix.a lib=nix
	$(MAKE) -C $(lc) kind=$(lc) rest libnix20.a lib=nix20
	$(MAKE) -C $(lc) kind=$(lc) rest libnixmain.a lib=nixmain
	rm -f lib/stubs/*_list__.o
	if [ ! -e $(lc)/libc.a ]; then $(AR) rcs $(lc)/libc.a; touch -t 0001010000 $(lc)/libc.a; fi
	$(AR) rcs $(lc)/libc.a \
	$$(find ./$(lc)/nix/* -name '*.o' -newer $(lc)/libc.a) \
	$$(find ./lib/stubs/* -name '*.o' -newer $(lc)/libc.a) \
	$$(find ./$(lc)/nixmain/* -name '*.o' -newer $(lc)/libc.a) \
	$$(find ./$(lc)/nix20/* -name '*.o' -newer $(lc)/libc.a)

rest: detach.o

detach.o: $(root)/sources/misc/detach.c
	$(CC) -c -Os -fomit-frame-pointer $(flags) $^ -o $@

# The string and memory functions, which sit in their callers' inner loops,
# stay at -O2 where $(flags) asks for -Os: at -Os, memmove() is 5-10% slower.
O2_SOURCES = /nix/string/|/nix/misc/b(copy|zero)\.c$$

# Build lib$(libname).a from sources/$(lib), for $(kind) with $(flags).
# Only the sources newer than the archive are recompiled, all of them if a header or this file changed.
# The headers are the public ones in sources/headers and the private ones next to the sources, like
# the printf and scanf engines.
# Every source compiles to <basename>.o in $(lib), so two sources with the same basename would replace each other's object, in the order find happens to list them.
headers := $(shell find $(root)/sources -name '*.h')
lib$(libname).a: $(shell find $(root)/sources/$(lib)/* -name '*.c') $(stolen) $(headers) $(root)/Makefile.m68k-amigaos
	@dups="$$(find $(root)/sources/$(lib)/* -name '*.c' | xargs -n1 basename | sort | uniq -d | xargs)"; \
	if [ -n "$$dups" ]; then echo "sources/$(lib) has more than one file named: $$dups" >&2; exit 1; fi
	@mkdir -p $(lib)
	@echo compiling for $(kind)/$@ using $(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags)
	@touch -t 0001010000 $(lib)/stamp && if [ -e $@ ]; then touch -r $@ $(lib)/stamp; fi
	@if [ "$$(find $(headers) -newer $(lib)/stamp)" != "" ]; then rm -f $(lib)/*.o $@; touch -t 0001010000 $(lib)/stamp; fi
	@if [ "$$(find $(root)/Makefile.m68k-amigaos -newer $(lib)/stamp)" != "" ]; then rm -f $(lib)/*.o $@; touch -t 0001010000 $(lib)/stamp; fi
	@cd $(lib) && files="$$(find $^ -name '*.c' -newer stamp)" && \
	o2="$$(printf '%s\n' $$files | grep -E '$(O2_SOURCES)' | xargs)" && \
	files="$$(printf '%s\n' $$files | grep -vE '$(O2_SOURCES)' | xargs)" && \
	if [ -n "$$files" ]; then echo "$(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags) $$files" && $(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags) $$files; fi && \
	if [ -n "$$o2" ]; then echo "$(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags) -O2 $$o2" && $(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags) -O2 $$o2; fi
	@objs="$$(find ./$(lib)/* -name '*.o' -newer $(lib)/stamp)" && echo "$(AR) rcs $@ $$objs" && \
	$(AR) rcs $@ $$objs

# libamiga.a, from the sources sfdc wrote and the support functions in
# sources/amiga.  There are too many for one command line, and all are compiled
# again when any of them, a header or this file changed.
amiga_sources = find $(gen)/amiga $(root)/sources/amiga -name '*.[cs]'
libamiga.a: $(gen)/amiga/stamp $(shell find $(root)/sources/amiga -name '*.c') $(headers) $(root)/Makefile.m68k-amigaos
	@dups="$$($(amiga_sources) | sed 's|.*/||; s|\.[cs]$$||' | sort | uniq -d | xargs)"; \
	if [ -n "$$dups" ]; then echo "$@ has more than one source named: $$dups" >&2; exit 1; fi
	@echo compiling for $(kind)/$@ using $(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags)
	@rm -rf amiga $@ && mkdir amiga
	@cd amiga && $(amiga_sources) | xargs $(CC) -c $(CFLAGS) $(LIB_CFLAGS) $(flags)
	@find amiga -name '*.o' | sort | xargs $(AR) rcs $@

libb/libnix4.library:
	cd libb && $(root)/preplib
	cd libb && $(root)/mkstub libnix4 libnix.def $$(cat ofiles.txt | xargs)
	cd libb && $(CC) -fno-use-linker-plugin -shared -mcrt=nix20 $$(cat ofiles.txt | xargs) \
	libnix4-support/export*.o \
	-o libnix4.library \
	-Wl,-ulibVersionMajor=$(MAJOR),-ulibVersionMinor=$(MINOR),-ulibName=libnix4 \
	$(STRIP)
	$(AR) rcs libb/libnix4.a lib/nix/__initlibraries.o lib/nix/__initcpp.o lib/nix20/__nocommandline.o lib/nixmain/__stdiowin.o
	rsync libb/libnix4.a $(PREFIX)/$(target)/libnix/lib/
	rsync libb/libnix4.library $(PREFIX)/$(target)/libnix/

# cleanup
clean:
	find * -name '*.o' -delete
	find * -name '*.a' -delete
	find * -name stamp -delete
	rm -rf $(gen)

info:
	@echo "$(uname)"
	@echo "root=$(root)"
